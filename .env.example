# One private password for the whole app. Use a long unique value.
APP_PASSWORD=replace-with-a-long-password
# A different random value used to sign login cookies.
SESSION_SECRET=replace-with-at-least-32-random-characters

# Local Docker Postgres. On Vercel, use the Supabase transaction-pooler URL
# with sslmode=require so serverless functions do not exhaust direct connections.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kalkarega

# Optional real web push. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Protects the scheduled reminder endpoint.
CRON_SECRET=replace-with-another-random-value
